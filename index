<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>三年級上學期期中識字認讀評量</title>
<style>
:root{--navy:#17324d;--blue:#2b6fba;--sky:#eaf5ff;--green:#24895a;--red:#cc4545;--gold:#f2b84b;--paper:#fffdf8;--muted:#657687}
*{box-sizing:border-box}html{min-height:100%;background:#e9f2f4}body{margin:0;color:var(--navy);font-family:"Noto Sans TC","Microsoft JhengHei",sans-serif;background:radial-gradient(circle at 12% 10%,#fff9d8 0 8%,transparent 8.5%),radial-gradient(circle at 90% 14%,#d8f1ff 0 9%,transparent 9.5%),linear-gradient(150deg,#edf7f4,#e8f2fb);min-height:100vh}
button,input,select{font:inherit}.app{width:min(1080px,calc(100% - 28px));margin:22px auto}.shell{background:rgba(255,255,255,.96);border:1px solid #d9e5ea;border-radius:28px;box-shadow:0 18px 50px #29465b24;overflow:hidden}.header{display:flex;align-items:center;gap:16px;padding:18px 25px;background:#fffaf0;border-bottom:1px solid #eedfbd}.mascot{font-size:48px;filter:drop-shadow(0 3px 1px #0001)}.title h1{font-size:clamp(22px,3.3vw,34px);margin:0}.title p{margin:4px 0 0;color:var(--muted);font-weight:700}.header-actions{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}.main{padding:25px}.screen[hidden]{display:none!important}.eyebrow{display:inline-block;background:#e4f2ff;color:#1f619f;border-radius:999px;padding:7px 13px;font-size:14px;font-weight:900;letter-spacing:.06em}.home-intro{text-align:center;padding:7px 0 22px}.home-intro h2{font-size:clamp(27px,4vw,40px);margin:12px 0 7px}.home-intro p{font-size:18px;color:var(--muted);margin:0}.student-box{display:flex;align-items:center;justify-content:center;gap:10px;margin:20px auto 10px;flex-wrap:wrap}.student-box label{font-weight:900}.student-box input{width:220px;border:2px solid #b9cedb;border-radius:12px;padding:11px 13px;font-size:18px}.lesson-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.lesson{position:relative;text-align:left;border:2px solid #c7d9e2;border-radius:20px;background:#fff;padding:20px;cursor:pointer;min-height:135px;transition:.18s}.lesson:hover,.lesson:focus-visible{transform:translateY(-3px);border-color:var(--blue);box-shadow:0 9px 22px #39749b20}.lesson .no{color:var(--blue);font-size:15px;font-weight:900}.lesson h3{font-size:24px;margin:7px 0 14px}.lesson .count{color:var(--muted);font-weight:700}.lesson .arrow{position:absolute;right:17px;bottom:15px;background:var(--sky);color:var(--blue);border-radius:999px;width:34px;height:34px;display:grid;place-items:center;font-weight:900}.subhead{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:18px}.subhead h2{font-size:30px;margin:5px 0}.subhead p{margin:0;color:var(--muted);font-weight:700}.mode-row{display:flex;gap:10px;flex-wrap:wrap}.btn{border:0;border-radius:13px;padding:11px 17px;font-weight:900;cursor:pointer}.btn-primary{background:var(--blue);color:#fff;box-shadow:0 4px 0 #19568f}.btn-primary:active{transform:translateY(2px);box-shadow:0 2px 0 #19568f}.btn-soft{background:#edf4f7;color:var(--navy)}.btn-gold{background:#ffdb78;color:#543d00;box-shadow:0 4px 0 #ddb450}.word-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:13px}.word-card{min-height:103px;border:3px solid #c2d4df;border-radius:17px;background:var(--paper);font-size:clamp(24px,3vw,34px);font-weight:900;color:var(--navy);cursor:pointer}.word-card:hover,.word-card:focus-visible{border-color:var(--blue);background:var(--sky)}.practice-note{text-align:center;color:var(--muted);font-weight:700;margin:19px 0 3px}.quiz-top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;margin-bottom:12px}.score{text-align:right;font-size:18px;font-weight:900}.progress-wrap{height:11px;background:#e5eef2;border-radius:99px;overflow:hidden}.progress-bar{height:100%;background:linear-gradient(90deg,#4aa3d8,#37a86d);transition:width .25s}.prompt{text-align:center;padding:15px 0 18px}.prompt h2{font-size:clamp(25px,3.7vw,38px);margin:9px 0}.prompt p{margin:0 0 14px;color:var(--muted);font-weight:700}.listen{border:0;border-radius:999px;background:#ffdc72;color:#543d00;padding:15px 25px;font-size:21px;font-weight:900;cursor:pointer;box-shadow:0 5px 0 #dcb64f}.listen:active{transform:translateY(3px);box-shadow:0 2px 0 #dcb64f}.quiz-grid .word-card{transition:.15s}.word-card.wrong{border-color:var(--red);background:#fff0f0;color:#a82e35;animation:shake .24s}.word-card.correct{border-color:var(--green);background:#e9f9ef;color:#176c43}.word-card.done{opacity:.38;pointer-events:none}.message{height:30px;text-align:center;font-size:19px;font-weight:900;margin-top:14px}.message.bad{color:var(--red)}.message.good{color:var(--green)}@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.result{text-align:center}.result-icon{font-size:62px}.result h2{font-size:34px;margin:5px}.big-score{font-size:64px;font-weight:1000;color:var(--blue);line-height:1}.summary{width:min(720px,100%);margin:21px auto;border-collapse:collapse;text-align:left}.summary th,.summary td{border-bottom:1px solid #d8e3e8;padding:10px}.summary th{background:#eef6f9}.summary .ok{color:var(--green);font-weight:900}.summary .miss{color:var(--red);font-weight:900}.result-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}.records{margin-top:26px;border-top:1px solid #d8e3e8;padding-top:18px}.records h3{margin:0 0 10px}.record-list{display:grid;gap:8px}.record-item{display:flex;justify-content:space-between;gap:15px;background:#f5f8fa;border-radius:11px;padding:10px 13px;color:#465c6d}.small{font-size:13px;color:var(--muted)}
.settings{display:flex;align-items:center;gap:8px}.settings select{border:1px solid #b9cad4;border-radius:9px;background:white;padding:7px}.back{background:#edf3f6;color:#29475d}.footer{text-align:center;padding:13px;color:#718390;font-size:13px}.print-only{display:none}
@media(max-width:780px){.lesson-grid{grid-template-columns:repeat(2,1fr)}.word-grid{grid-template-columns:repeat(2,1fr)}.word-card{min-height:78px}.header{align-items:flex-start}.header-actions{display:none}.quiz-top{grid-template-columns:1fr auto}.quiz-top .settings{grid-column:1/-1;justify-content:center}.main{padding:18px}.subhead{flex-direction:column}.mode-row{width:100%}.mode-row .btn{flex:1}.score{font-size:16px}}
@media(max-width:460px){.lesson-grid{grid-template-columns:1fr}.word-grid{gap:9px}.mascot{font-size:38px}.title p{display:none}.app{width:min(100% - 14px,1080px);margin:7px auto}.shell{border-radius:19px}.header{padding:13px}.main{padding:14px}.word-card{font-size:26px}.quiz-top{grid-template-columns:1fr}.score{text-align:center}}
@media print{body{background:#fff}.app{width:100%;margin:0}.shell{box-shadow:none;border:0}.header,.footer,.result-actions,.records{display:none}.main{padding:0}.screen{display:none!important}#resultScreen{display:block!important}.print-only{display:block}.summary{font-size:14px}}
</style>
</head>
<body>
<main class="app"><section class="shell">
  <header class="header"><div class="mascot" aria-hidden="true">🐵</div><div class="title"><h1>期中識字認讀評量</h1><p>三年級上學期・第1～6課</p></div><div class="header-actions"><button class="btn btn-soft" id="homeTop">回首頁</button></div></header>
  <div class="main">
    <section class="screen" id="homeScreen">
      <div class="home-intro"><span class="eyebrow">聽音找詞・每課10詞</span><h2>選一課開始認讀</h2><p>先練習，再進行10題闖關；每題10分，滿分100分。</p>
        <div class="student-box"><label for="studentName">學生姓名</label><input id="studentName" maxlength="12" placeholder="可先不填" autocomplete="off"></div>
      </div><div class="lesson-grid" id="lessonGrid"></div>
      <section class="records" id="recordsBox"><h3>本機最近紀錄</h3><div class="record-list" id="recordList"></div></section>
    </section>
    <section class="screen" id="lessonScreen" hidden>
      <div class="subhead"><div><span class="eyebrow" id="lessonLabel"></span><h2 id="lessonTitle"></h2><p>點選詞語，可聽到完整詞語的讀音。</p></div><div class="mode-row"><button class="btn back" id="backHome1">返回選課</button><button class="btn btn-primary" id="startQuiz">開始闖關</button></div></div>
      <div class="word-grid" id="practiceGrid"></div><p class="practice-note">正式使用時，可將合成語音換成老師錄製的真人語音。</p>
    </section>
    <section class="screen" id="quizScreen" hidden>
      <div class="quiz-top"><button class="btn back" id="quitQuiz">結束闖關</button><div class="settings"><label for="speechRate">語速</label><select id="speechRate"><option value="0.62">很慢</option><option value="0.75" selected>慢速</option><option value="0.9">正常</option></select></div><div class="score">第 <span id="qNo">1</span>／10題　得分 <span id="score">0</span></div></div>
      <div class="progress-wrap"><div class="progress-bar" id="progressBar"></div></div>
      <div class="prompt"><h2>聽一聽，找出正確的圈詞</h2><p>答錯可以再找一次；只有第一次作答計分。</p><button class="listen" id="listenBtn">🔊 聽詞語</button></div>
      <div class="word-grid quiz-grid" id="quizGrid"></div><div class="message" id="message" aria-live="polite"></div>
    </section>
    <section class="screen" id="resultScreen" hidden>
      <div class="result"><div class="print-only"><h1>三年級上學期期中識字認讀評量</h1></div><div class="result-icon">🌟</div><h2 id="resultTitle">闖關完成</h2><p id="resultMeta"></p><div class="big-score"><span id="finalScore">0</span>分</div><table class="summary"><thead><tr><th>圈詞</th><th>第一次作答</th><th>重聽</th><th>完成情形</th></tr></thead><tbody id="summaryBody"></tbody></table><div class="result-actions"><button class="btn btn-primary" id="retry">再評量一次</button><button class="btn btn-soft" id="printResult">列印紀錄</button><button class="btn btn-soft" id="exportCsv">匯出CSV</button><button class="btn btn-gold" id="backHome2">回到選課</button></div></div>
    </section>
  </div><footer class="footer">認讀評量與國字注音紙筆評量搭配使用，可分別觀察認字與書寫表現。</footer>
</section></main>
<script>
const lessons=[
 {no:1,title:'你好，新朋友',words:['泥土','輕快','清脆','頭髮','四處','旅行','平安','男孩','開朗','足球']},
 {no:2,title:'我們的約定',words:['走廊','訂定','班級','公約','主持','記錄','聊天','熱烈','這些','提醒']},
 {no:3,title:'下課十分鐘',words:['長短','分鐘','熱鬧','準確','舞蹈','手足','表情','總是','音響','盡責']},
 {no:4,title:'一顆黑點',words:['煩惱','吵鬧','勉強','忍耐','理解','接著','筆尖','雖然','脾氣','嗓門']},
 {no:5,title:'火大了',words:['身體','兄弟','注入','受傷','死亡','原諒','舒適','盡力','消防','警鈴']},
 {no:6,title:'我該怎麼辦',words:['杯子','水流','溼透','雙手','負責','逃走','露出','問題','灰色','剪刀']}
];
const $=s=>document.querySelector(s);let current=null,order=[],qIndex=0,points=0,firstTry=true,replays=0,results=[],advanceTimer=null;
function show(id){document.querySelectorAll('.screen').forEach(x=>x.hidden=true);$(id).hidden=false;scrollTo({top:0,behavior:'smooth'})}
function speak(word,countReplay=false){speechSynthesis.cancel();if(countReplay&&$('#quizScreen').hidden===false)replays++;const u=new SpeechSynthesisUtterance(word);u.lang='zh-TW';u.rate=Number($('#speechRate')?.value||.75);u.pitch=1;u.volume=1;speechSynthesis.speak(u)}
function shuffle(a){a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function renderHome(){show('#homeScreen');$('#lessonGrid').innerHTML=lessons.map(l=>`<button class="lesson" data-no="${l.no}"><span class="no">第${l.no}課</span><h3>${l.title}</h3><span class="count">10個核心圈詞</span><span class="arrow">→</span></button>`).join('');document.querySelectorAll('.lesson').forEach(b=>b.onclick=()=>openLesson(Number(b.dataset.no)));renderRecords()}
function openLesson(no){current=lessons.find(l=>l.no===no);$('#lessonLabel').textContent=`第${current.no}課・認讀教室`;$('#lessonTitle').textContent=current.title;$('#practiceGrid').innerHTML=current.words.map(w=>`<button class="word-card" data-word="${w}">${w}</button>`).join('');$('#practiceGrid').querySelectorAll('.word-card').forEach(b=>b.onclick=()=>speak(b.dataset.word));show('#lessonScreen')}
function startQuiz(){clearTimeout(advanceTimer);order=shuffle(current.words);qIndex=0;points=0;results=[];renderQuestion();show('#quizScreen');setTimeout(()=>speak(order[0]),350)}
function renderQuestion(){firstTry=true;replays=0;$('#qNo').textContent=qIndex+1;$('#score').textContent=points;$('#progressBar').style.width=`${qIndex*10}%`;$('#message').textContent='';$('#message').className='message';$('#quizGrid').innerHTML=current.words.map(w=>`<button class="word-card" data-word="${w}">${w}</button>`).join('');$('#quizGrid').querySelectorAll('.word-card').forEach(b=>b.onclick=()=>answer(b))}
function answer(btn){if(btn.classList.contains('done'))return;const target=order[qIndex],chosen=btn.dataset.word,wasFirst=firstTry;if(chosen!==target){btn.classList.add('wrong');setTimeout(()=>btn.classList.remove('wrong'),500);$('#message').textContent='再找找看';$('#message').className='message bad';firstTry=false;return}btn.classList.add('correct');$('#quizGrid').querySelectorAll('.word-card').forEach(b=>b.classList.add('done'));if(wasFirst)points+=10;results.push({word:target,firstCorrect:wasFirst,replays});$('#score').textContent=points;$('#message').textContent=wasFirst?'答對了！':'找到了！';$('#message').className='message good';advanceTimer=setTimeout(()=>{qIndex++;if(qIndex<10){renderQuestion();setTimeout(()=>speak(order[qIndex]),240)}else finish()},750)}
function finish(){speechSynthesis.cancel();$('#progressBar').style.width='100%';const name=$('#studentName').value.trim()||'未填姓名';$('#resultMeta').textContent=`${name}｜第${current.no}課 ${current.title}`;$('#finalScore').textContent=points;$('#summaryBody').innerHTML=results.map(r=>`<tr><td>${r.word}</td><td class="${r.firstCorrect?'ok':'miss'}">${r.firstCorrect?'正確':'錯誤'}</td><td>${r.replays}次</td><td>${r.firstCorrect?'獨立辨認':'再次嘗試後完成'}</td></tr>`).join('');saveRecord({time:new Date().toLocaleString('zh-TW',{hour12:false}),name,lesson:current.no,title:current.title,score:points,results});show('#resultScreen')}
function saveRecord(r){const list=JSON.parse(localStorage.getItem('wordReadingRecords')||'[]');list.unshift(r);localStorage.setItem('wordReadingRecords',JSON.stringify(list.slice(0,30)))}
function renderRecords(){const list=JSON.parse(localStorage.getItem('wordReadingRecords')||'[]');$('#recordsBox').style.display=list.length?'block':'none';$('#recordList').innerHTML=list.slice(0,6).map(r=>`<div class="record-item"><span><b>${r.name}</b>・第${r.lesson}課 ${r.title}<br><span class="small">${r.time}</span></span><b>${r.score}分</b></div>`).join('')}
function exportCsv(){const name=$('#studentName').value.trim()||'未填姓名',rows=[['學生','課次','課名','圈詞','第一次作答','重聽次數','得分'],...results.map(r=>[name,current.no,current.title,r.word,r.firstCorrect?'正確':'錯誤',r.replays,r.firstCorrect?10:0])];const csv='\ufeff'+rows.map(row=>row.map(v=>`"${String(v).replaceAll('"','""')}"`).join(',')).join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download=`${name}_第${current.no}課_識字認讀_${points}分.csv`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
$('#startQuiz').onclick=startQuiz;$('#listenBtn').onclick=()=>speak(order[qIndex],true);$('#retry').onclick=startQuiz;$('#printResult').onclick=()=>print();$('#exportCsv').onclick=exportCsv;$('#backHome1').onclick=renderHome;$('#backHome2').onclick=renderHome;$('#homeTop').onclick=renderHome;$('#quitQuiz').onclick=()=>{speechSynthesis.cancel();clearTimeout(advanceTimer);openLesson(current.no)};renderHome();
</script>
</body>
</html>
